{
  "expo": {
    "name": "Genestac",
    "slug": "genestac-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.genestac.mobile",
      "infoPlist": {
        "NSMotionUsageDescription": "We use motion data to count your daily steps."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.genestac.mobile",
      "permissions": ["ACTIVITY_RECOGNITION"],
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "genestac"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "genestac",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#0B6B54"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8dbf39f4-6b88-41cf-83f2-3ed625f213de"
      }
    }
  }
}
